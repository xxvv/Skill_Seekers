      "selectors": {
        "main_content": ".van-doc-content",
        "title": ".van-doc-content h1",
        "code_blocks": ".van-doc-content pre code,.van-doc-content table"
      },
      "url_patterns": {
        "include": ["/"]
      },
      "categories": {
        "getting_started": ["代码规范", "代码提交规范"],
        "components": ["代码演示", "API"]
      },
      "rate_limit": 0.5,
      "max_pages": 200,
      "render_js": {
        "enabled": true,
        "wait_for": ".van-doc-content",
        "wait_after": 0.5,
        "timeout": 30,
        "browser_executable": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
      }
    },
    {
      "type": "github",
      "github_local_path": "E:\\项目\\h5-app3",
      "github_repo_name": "sinimas",
      "include_untracked": false,
      "show_absolute_path": false,
      "include_code": true,
      "code_analysis_depth": "surface",
      "include_issues": true,
      "max_issues": 80,
      "include_changelog": true,
      "include_releases": true,
      "file_patterns": [
        "src/**/*.vue",
        "src/**/*.js",
        "src/**/*.ts",
        "packages/**/package.json"
      ]
    }
  ]
}
